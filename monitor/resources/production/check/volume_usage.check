  - name: Volume Usage
    detail: Check for per mountpoint volume percent used threshold exceeds 80% 
    fluxfile: flux/volume_usage.flux
    severity: 1
    threshold: 90
    comparison: gt
    tags: 
      - host
      - _field
      - _measurement
      - path
    interval: 900
    target: xapi
    action: | 
              Login and attempt to clean up the volume. If this is a system volume, escalate to a user with root access. 